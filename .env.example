# Application
KNOWLEDGEHUB_APP_NAME=KnowledgeHub
KNOWLEDGEHUB_ENVIRONMENT=local
KNOWLEDGEHUB_LOG_LEVEL=INFO

# Ollama
KNOWLEDGEHUB_OLLAMA_BASE_URL=http://localhost:11434
KNOWLEDGEHUB_OLLAMA_CHAT_MODEL=qwen3:8b
KNOWLEDGEHUB_OLLAMA_EMBEDDING_MODEL=qwen3-embedding:8b
KNOWLEDGEHUB_EMBEDDING_DIMENSIONS=1024

# PostgreSQL / pgvector
KNOWLEDGEHUB_POSTGRES_URL=postgresql+psycopg://postgres:postgres@localhost:5432/knowledgehub
KNOWLEDGEHUB_VECTOR_SCHEMA=public
KNOWLEDGEHUB_VECTOR_TABLE_NAME=rag_documents

# RAG retrieval
KNOWLEDGEHUB_RETRIEVAL_TOP_K=5

# Chunking
KNOWLEDGEHUB_CHUNK_SIZE=800
KNOWLEDGEHUB_CHUNK_OVERLAP=120

# File storage
KNOWLEDGEHUB_DOCUMENT_ROOT=./app/data/documents
KNOWLEDGEHUB_MAX_UPLOAD_BYTES=20971520